# UniFi Toolkit under App Launcher: this server's settings.
# Copy to /srv/apps/unifi-toolkit/.env and fill in. Never commit the real file.
# See docs/APP-LAUNCHER.md for each step.

# --- Image --------------------------------------------------------------
# stable = latest release. edge = latest main build (testing only).
APP_TAG=stable

# --- Ports --------------------------------------------------------------
# Host port the toolkit is published on.
HOST_PORT=8000
# 127.0.0.1 when the tile is behind App Launcher's gateway (recommended), so
# the plain-http port isn't reachable from the network.
HOST_BIND=127.0.0.1

# --- Core (required) ----------------------------------------------------
# Generate once and never change it, or stored UniFi credentials are lost:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# local = no Caddy. Sign-in is still required, because LAUNCHER_ISSUER is set.
DEPLOYMENT_TYPE=local
LOG_LEVEL=INFO

# The hostname people use in the browser (the gateway's name), so the
# anti-DNS-rebinding check accepts it. The LAUNCHER_REDIRECT_URI host is
# accepted automatically.
DOMAIN=

# --- Sign in with App Launcher -----------------------------------------
# The launcher's own address, no path. Setting it turns sign-in on.
LAUNCHER_ISSUER=https://apps.lakelandlakers.net:8443
# The name the container resolves to this machine (see extra_hosts).
LAUNCHER_HOSTNAME=apps.lakelandlakers.net
# From App Launcher: Management > Sign-in > Add app.
LAUNCHER_CLIENT_ID=unifi-toolkit
LAUNCHER_CLIENT_SECRET=
# Exactly what is registered in App Launcher. For a gateway tile, the gateway
# address, e.g. https://apps.lakelandlakers.net:9402/auth/launcher/callback
LAUNCHER_REDIRECT_URI=
# Blank = the same address with /login.
LAUNCHER_POST_LOGOUT_REDIRECT_URI=
# The launcher's CA certificate (its data/tls/ca.pem, not cert.pem), copied
# into ./data. Blank = the system trust store.
LAUNCHER_CA_FILE=/app/data/launcher-ca.pem
LAUNCHER_BUTTON_LABEL=Sign in with App Launcher
# true hides the password form. The break-glass form stays at /login?local=1.
LAUNCHER_ONLY=false

# --- Break-glass local admin (optional, recommended) -------------------
# Generate the hash with ./reset_password.sh (it writes it correctly), or:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode().replace('$', '$$'))"
# Docker Compose reads $ in this file as a variable, so every $ in the hash
# must be written as $$.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
