# UniFi Toolkit under App Launcher: this server's settings.
# App Launcher's Add app form shows these and fills in the launcher ones.
# See docs/APP-LAUNCHER.md.

# --- Image --------------------------------------------------------------
# stable = latest release. edge = latest main build (testing only).
APP_TAG=stable

# --- Ports --------------------------------------------------------------
# Host port the toolkit is published on. Add app suggests another if taken.
HOST_PORT=8000
# Where the plain-http port listens. Only App Launcher's gateway should reach
# it (sign-in needs the gateway's HTTPS):
# - Linux: 172.17.0.1 (Docker's bridge). The gateway reaches apps through it;
#   127.0.0.1 is NOT reachable from the launcher's container on Linux, and the
#   tile then shows "UniFi Toolkit isn't responding".
# - Docker Desktop (Windows/Mac): 127.0.0.1.
# 0.0.0.0 also exposes it on the network (not recommended).
HOST_BIND=172.17.0.1

# --- Core ---------------------------------------------------------------
# Leave blank: the toolkit generates one in data/encryption.key on first
# start, next to the database it protects. Moving an existing install? Put
# its old key here, or stored UniFi credentials can't be decrypted.
ENCRYPTION_KEY=

# local = no Caddy. Sign-in is still required, because LAUNCHER_ISSUER is set.
DEPLOYMENT_TYPE=local
LOG_LEVEL=INFO

# --- Sign in with App Launcher -----------------------------------------
# Filled in by App Launcher (its own address and name).
LAUNCHER_ISSUER=
LAUNCHER_HOSTNAME=
# The toolkit's address as people reach it, e.g. the gateway
# https://apps.example.org:9402. App Launcher keeps it current. Blank = the
# address each request came in on.
APP_PUBLIC_URL=
# From App Launcher: Management > Sign-in > Add app. Until the secret is set,
# the toolkit stays locked and its login page says so.
LAUNCHER_CLIENT_ID=unifi-toolkit
LAUNCHER_CLIENT_SECRET=
# Blank = APP_PUBLIC_URL + /auth/launcher/callback (and /login after sign-out).
# Set only if App Launcher registered a different address.
LAUNCHER_REDIRECT_URI=
LAUNCHER_POST_LOGOUT_REDIRECT_URI=
# Blank = the system's certificates (a launcher with a public certificate).
# A launcher with its own CA: copy its data/tls/ca.pem to this app's
# data/launcher-ca.pem and set /app/data/launcher-ca.pem.
LAUNCHER_CA_FILE=
LAUNCHER_BUTTON_LABEL=Sign in with App Launcher
# true hides the password form. The break-glass form stays at /login?local=1.
LAUNCHER_ONLY=false

# --- Break-glass local admin (optional, recommended) -------------------
# python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-PASSWORD', bcrypt.gensalt()).decode().replace('$', '$$'))"
# Docker Compose reads $ in this file as a variable, so every $ in the hash
# must be written as $$.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
